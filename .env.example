# Copiez ce fichier en « .env » puis complétez-le.
# Le fichier .env contient votre clé secrète : il est ignoré par Git (.gitignore), ne le publiez jamais.

# Quel modèle de langage utiliser : "openrouter" (distant, gratuit avec un compte) ou "local" (sur ce PC)
LLM_PROVIDER=openrouter

# Clé OpenRouter : créez-la gratuitement sur https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modèle OpenRouter (les modèles « :free » sont gratuits mais limités à 20 requêtes/min et 50/jour)
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Petit modèle Hugging Face exécuté en local (téléchargé automatiquement au premier usage, ~3 Go)
# Qwen/Qwen2.5-0.5B-Instruct est 3 fois plus rapide mais trop faible (voir le README)
LOCAL_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Version du prompt utilisée par l'application : v1 ou v2 (fichiers du dossier prompts/)
PROMPT_VERSION=v2

# Taille des passages en mots (100 ou 300, voir la comparaison dans le README)
CHUNK_SIZE=100

# Seuil de similarité : en dessous, l'assistant répond « Je ne sais pas » sans appeler le LLM
MIN_SIMILARITY=0.85

# Adresse de l'API FastAPI (utilisée par l'interface Streamlit)
API_URL=http://127.0.0.1:8000
